index 0000000..4fb2d6a
--- /dev/null
+++ b/cmd/serve/nfs/appledouble.go
@@ -0,0 +1,248 @@
+//go:build unix
+
+package nfs
+
+import (
+	"container/list"
+	"io"
+	"os"
+	"path"
+	"strings"
+	"sync"
+	"time"
+
+	billy "github.com/go-git/go-billy/v5"
+	"github.com/willscott/go-nfs/file"
+)
+
+// appleDoubles holds in memory the ._ files the macOS NFS client writes to keep extended attributes, when
+// the filters exclude them. The VFS does not filter writes, so they would otherwise be uploaded, and
+// refusing them makes every copy of a file carrying attributes fail. The remote could not keep the
+// attributes anyway: the files live until removed, or until the least recently used are dropped.
+type appleDoubles struct {
+	mu       sync.Mutex
+	byPath   map[string]*list.Element
+	recent   *list.List // of *appleDouble, most recently used first
+	next     uint64
+	uid, gid uint32
+}
+
+// maxAppleDoubles bounds the memory used: a ._ file holding a few attributes is around 4 KiB.
+const maxAppleDoubles = 4096
+
+type appleDouble struct {
+	path  string
+	data  []byte
+	mode  os.FileMode
+	mtime time.Time
+	inode uint64
+}
+
+func newAppleDoubles(uid, gid uint32) *appleDoubles {
+	// Far above the VFS inode counter, so file ids never collide.
+	return &appleDoubles{byPath: map[string]*list.Element{}, recent: list.New(), next: 1 << 62, uid: uid, gid: gid}
+}
+
+func isAppleDouble(name string) bool {
+	return strings.HasPrefix(path.Base(name), "._")
+}
+
+// get returns the file at p, marking it as recently used. Called with the lock held.
+func (a *appleDoubles) get(p string) *appleDouble {
+	element, ok := a.byPath[p]
+	if !ok {
+		return nil
+	}
+	a.recent.MoveToFront(element)
+	return element.Value.(*appleDouble)
+}
+
+// add stores f at its path, dropping the least recently used past the limit. Called with the lock held.
+func (a *appleDoubles) add(f *appleDouble) {
+	if old, ok := a.byPath[f.path]; ok {
+		a.recent.Remove(old)
+	}
+	a.byPath[f.path] = a.recent.PushFront(f)
+	for a.recent.Len() > maxAppleDoubles {
+		oldest := a.recent.Back()
+		a.recent.Remove(oldest)
+		delete(a.byPath, oldest.Value.(*appleDouble).path)
+	}
+}
+
+func (a *appleDoubles) open(p, name string, flag int, perm os.FileMode) (billy.File, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	f := a.get(p)
+	switch {
+	case f == nil && flag&os.O_CREATE == 0:
+		return nil, os.ErrNotExist
+	case f != nil && flag&os.O_CREATE != 0 && flag&os.O_EXCL != 0:
+		return nil, os.ErrExist
+	case f == nil:
+		a.next++
+		f = &appleDouble{path: p, mode: perm.Perm(), mtime: time.Now(), inode: a.next}
+		if f.mode == 0 {
+			f.mode = 0o644
+		}
+		a.add(f)
+	case flag&os.O_TRUNC != 0:
+		f.data = nil
+		f.mtime = time.Now()
+	}
+	handle := &appleDoubleFile{store: a, file: f, name: name}
+	if flag&os.O_APPEND != 0 {
+		handle.offset = int64(len(f.data))
+	}
+	return handle, nil
+}
+
+func (a *appleDoubles) stat(p string) (os.FileInfo, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	f := a.get(p)
+	if f == nil {
+		return nil, os.ErrNotExist
+	}
+	return a.info(f), nil
+}
+
+// info snapshots f. Called with the lock held.
+func (a *appleDoubles) info(f *appleDouble) os.FileInfo {
+	return appleDoubleInfo{name: path.Base(f.path), size: int64(len(f.data)), mode: f.mode, mtime: f.mtime,
+		sys: &file.FileInfo{Nlink: 1, UID: a.uid, GID: a.gid, Fileid: f.inode}}
+}
+
+func (a *appleDoubles) remove(p string) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	element, ok := a.byPath[p]
+	if !ok {
+		return os.ErrNotExist
+	}
+	a.recent.Remove(element)
+	delete(a.byPath, p)
+	return nil
+}
+
+func (a *appleDoubles) rename(oldPath, newPath string) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	f := a.get(oldPath)
+	if f == nil {
+		return os.ErrNotExist
+	}
+	a.recent.Remove(a.byPath[oldPath])
+	delete(a.byPath, oldPath)
+	f.path = newPath
+	a.add(f)
+	return nil
+}
+
+func (a *appleDoubles) change(p string, apply func(f *appleDouble)) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	f := a.get(p)
+	if f == nil {
+		return os.ErrNotExist
+	}
+	apply(f)
+	return nil
+}
+
+type appleDoubleInfo struct {
+	name  string
+	size  int64
+	mode  os.FileMode
+	mtime time.Time
+	sys   *file.FileInfo
+}
+
+func (i appleDoubleInfo) Name() string       { return i.name }
+func (i appleDoubleInfo) Size() int64        { return i.size }
+func (i appleDoubleInfo) Mode() os.FileMode  { return i.mode }
+func (i appleDoubleInfo) ModTime() time.Time { return i.mtime }
+func (i appleDoubleInfo) IsDir() bool        { return false }
+func (i appleDoubleInfo) Sys() any           { return i.sys }
+
+// appleDoubleFile is an open handle on an in-memory ._ file.
+type appleDoubleFile struct {
+	store  *appleDoubles
+	file   *appleDouble
+	name   string
+	offset int64
+}
+
+func (h *appleDoubleFile) Name() string { return h.name }
+
+func (h *appleDoubleFile) Read(p []byte) (int, error) {
+	n, err := h.ReadAt(p, h.offset)
+	h.offset += int64(n)
+	return n, err
+}
+
+func (h *appleDoubleFile) ReadAt(p []byte, off int64) (int, error) {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	if off >= int64(len(h.file.data)) {
+		return 0, io.EOF
+	}
+	n := copy(p, h.file.data[off:])
+	if n < len(p) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+func (h *appleDoubleFile) Write(p []byte) (int, error) {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	end := h.offset + int64(len(p))
+	if end > int64(len(h.file.data)) {
+		data := make([]byte, end)
+		copy(data, h.file.data)
+		h.file.data = data
+	}
+	copy(h.file.data[h.offset:], p)
+	h.offset = end
+	h.file.mtime = time.Now()
+	return len(p), nil
+}
+
+func (h *appleDoubleFile) Seek(offset int64, whence int) (int64, error) {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += h.offset
+	case io.SeekEnd:
+		offset += int64(len(h.file.data))
+	default:
+		return h.offset, os.ErrInvalid
+	}
+	if offset < 0 {
+		return h.offset, os.ErrInvalid
+	}
+	h.offset = offset
+	return offset, nil
+}
+
+func (h *appleDoubleFile) Truncate(size int64) error {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	if size < 0 {
+		return os.ErrInvalid
+	}
+	data := make([]byte, size)
+	copy(data, h.file.data)
+	h.file.data = data
+	h.file.mtime = time.Now()
+	return nil
+}
+
+func (h *appleDoubleFile) Close() error  { return nil }
+func (h *appleDoubleFile) Lock() error   { return nil }
+func (h *appleDoubleFile) Unlock() error { return nil }
+
+var _ billy.File = (*appleDoubleFile)(nil)
diff --git a/cmd/serve/nfs/appledouble_test.go b/cmd/serve/nfs/appledouble_test.go
new file mode 100644
index 0000000..bf5238b
--- /dev/null
+++ b/cmd/serve/nfs/appledouble_test.go
@@ -0,0 +1,82 @@
+//go:build unix
+
+package nfs
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/willscott/go-nfs/file"
+)
+
+func TestAppleDoublesInMemory(t *testing.T) {
+	// No VFS: every call below must be served from memory.
+	f := &FS{ad: newAppleDoubles(501, 20)}
+
+	w, err := f.Create("dir/._photo.jpg")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("attributes"))
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	fi, err := f.Stat("dir/._photo.jpg")
+	require.NoError(t, err)
+	assert.Equal(t, "._photo.jpg", fi.Name())
+	assert.Equal(t, int64(10), fi.Size())
+	sys, ok := fi.Sys().(*file.FileInfo)
+	require.True(t, ok)
+	assert.Equal(t, uint32(501), sys.UID)
+	assert.GreaterOrEqual(t, sys.Fileid, uint64(1<<62))
+
+	_, err = f.OpenFile("dir/._photo.jpg", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o644)
+	assert.ErrorIs(t, err, os.ErrExist)
+
+	rw, err := f.OpenFile("dir/._photo.jpg", os.O_RDWR, 0)
+	require.NoError(t, err)
+	_, err = rw.Seek(4, io.SeekStart)
+	require.NoError(t, err)
+	_, err = rw.Write([]byte("IBUTES-X"))
+	require.NoError(t, err)
+	got := make([]byte, 32)
+	n, err := rw.ReadAt(got, 0)
+	assert.Equal(t, io.EOF, err)
+	assert.Equal(t, "attrIBUTES-X", string(got[:n]))
+	require.NoError(t, rw.Truncate(4))
+
+	require.NoError(t, f.Rename("dir/._photo.jpg", "dir/._image.jpg"))
+	_, err = f.Stat("dir/._photo.jpg")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	fi, err = f.Lstat("dir/._image.jpg")
+	require.NoError(t, err)
+	assert.Equal(t, int64(4), fi.Size())
+
+	assert.ErrorIs(t, f.Rename("dir/._image.jpg", "dir/image.jpg"), os.ErrPermission)
+	require.NoError(t, f.Chmod("dir/._image.jpg", 0o600))
+	require.NoError(t, f.Remove("dir/._image.jpg"))
+	_, err = f.Open("dir/._image.jpg")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	assert.ErrorIs(t, f.Remove("dir/._image.jpg"), os.ErrNotExist)
+}
+
+func TestAppleDoublesDropLeastRecentlyUsed(t *testing.T) {
+	ad := newAppleDoubles(0, 0)
+	for i := range maxAppleDoubles + 1 {
+		_, err := ad.open(fmt.Sprintf("/._%d", i), "", os.O_CREATE|os.O_RDWR, 0o644)
+		require.NoError(t, err)
+		if i == 0 {
+			continue
+		}
+		// Keep the first file in use, so the second is the least recently used.
+		_, err = ad.stat("/._0")
+		require.NoError(t, err)
+	}
+	_, err := ad.stat("/._0")
+	assert.NoError(t, err)
+	_, err = ad.stat("/._1")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	assert.Equal(t, maxAppleDoubles, ad.recent.Len())
+}
