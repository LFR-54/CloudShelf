-	if shouldIgnoreAppleXattr(fsys.opt) && strings.HasPrefix(name, "com.apple.") {
+	if discardXattrs(fsys.opt) || shouldIgnoreAppleXattr(fsys.opt) && strings.HasPrefix(name, "com.apple.") {
 		return 0
 	}
 	return -fuse.ENOSYS
@@ -583,7 +590,7 @@ func (fsys *FS) Removexattr(path string, name string) (errc int) {
 // Listxattr lists extended attributes.
 func (fsys *FS) Listxattr(path string, fill func(name string) bool) (errc int) {
 	defer log.Trace(path, "fill=%p", fill)("errc=%d", &errc)
-	if shouldIgnoreAppleXattr(fsys.opt) {
