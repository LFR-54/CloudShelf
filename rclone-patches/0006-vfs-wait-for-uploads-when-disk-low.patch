+// WaitForSpace holds a write while the disk of the cache has less than --vfs-cache-min-free-space available
+// and uploads are pending, removing each file once sent, so that writes slow down to the upload speed
+// instead of filling the disk.
+//
+// It returns at once when no upload is pending, as the file being written is only sent once closed, and
+// after spaceWait, so the write goes ahead and the next one waits again.
+func (c *Cache) WaitForSpace() {
+	if c.opt.CacheMinFreeSpace <= 0 || time.Now().UnixNano() < c.spaceOKUntil.Load() {
+		return
+	}
+	deadline := time.Now().Add(spaceWait)
+	for !c.minFreeSpaceQuotaOK() {
+		if inProgress, queued := c.writeback.Stats(); inProgress+queued == 0 || time.Now().After(deadline) {
+			return
+		}
+		// The cleaner would only remove the files sent since at its next pass.
+		c.purgeOverQuota()
+		time.Sleep(100 * time.Millisecond)
+	}
+	// Checking at most every 100 ms keeps statfs out of most writes.
+	c.spaceOKUntil.Store(time.Now().Add(100 * time.Millisecond).UnixNano())
+}
