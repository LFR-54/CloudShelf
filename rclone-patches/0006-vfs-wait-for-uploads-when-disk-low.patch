+// spaceWait bounds how long WaitForSpace holds one write, well below --daemon-timeout, after which the
+// kernel gives up on the mount.
+const spaceWait = 10 * time.Second
+
 // AddVirtualFn if registered by the WithAddVirtual method, can be
