+package macmeta
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMatch(t *testing.T) {
+	for p, want := range map[string]bool{
+		"/._photo.jpg":    true,
+		"dir/._":          true,
+		"dir/.DS_Store":   true,
+		".DS_Store":       true,
+		"dir/photo.jpg":   false,
+		"._dir/photo.jpg": false,
+		"dir/.DS_Store2":  false,
+		"dir/_photo.jpg":  false,
+	} {
+		assert.Equal(t, want, Match(p), p)
+	}
+}
+
+func TestReadWriteAt(t *testing.T) {
+	s := New()
+	_, err := s.Open("/.DS_Store", os.O_RDWR, 0)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+
+	h, err := s.Open("/.DS_Store", os.O_CREATE|os.O_WRONLY, 0)
+	require.NoError(t, err)
+	_, err = h.WriteAt([]byte("world"), 6)
+	require.NoError(t, err)
+	_, err = h.WriteAt([]byte("hello"), 0)
+	require.NoError(t, err)
+
+	got := make([]byte, 16)
+	n, err := h.ReadAt(got, 0)
+	assert.Equal(t, io.EOF, err)
+	assert.Equal(t, "hello\x00world", string(got[:n]))
+	info := h.Stat()
+	assert.Equal(t, int64(11), info.Size())
+	assert.Equal(t, os.FileMode(0o644), info.Mode())
+
+	mtime := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	require.NoError(t, s.Chtimes("/.DS_Store", mtime))
+	info, err = s.Stat("/.DS_Store")
+	require.NoError(t, err)
+	assert.Equal(t, mtime, info.ModTime())
+
+	appended, err := s.Open("/.DS_Store", os.O_WRONLY|os.O_APPEND, 0)
+	require.NoError(t, err)
+	_, err = appended.Write([]byte("!"))
+	require.NoError(t, err)
+	truncated, err := s.Open("/.DS_Store", os.O_RDWR|os.O_TRUNC, 0)
+	require.NoError(t, err)
+	assert.Equal(t, int64(0), truncated.Stat().Size())
+
+	require.NoError(t, s.Remove("/.DS_Store"))
+	_, err = s.Stat("/.DS_Store")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	// An open handle outlives the removal.
+	assert.Equal(t, int64(0), h.Stat().Size())
+}
+
+func TestDropLeastRecentlyUsed(t *testing.T) {
+	s := New()
+	for i := range MaxFiles + 1 {
+		_, err := s.Open(fmt.Sprintf("/._%d", i), os.O_CREATE|os.O_RDWR, 0o644)
+		require.NoError(t, err)
+		if i == 0 {
+			continue
+		}
+		// Keep the first file in use, so the second is the least recently used.
+		_, err = s.Stat("/._0")
+		require.NoError(t, err)
+	}
+	_, err := s.Stat("/._0")
+	assert.NoError(t, err)
+	_, err = s.Stat("/._1")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	assert.Equal(t, MaxFiles, s.recent.Len())
+}
+
+func TestDirectories(t *testing.T) {
+	s := New()
+	for _, p := range []string{"/a/.DS_Store", "/a/b/._f", "/ab/.DS_Store", "/c/.DS_Store", "/._a"} {
+		_, err := s.Open(p, os.O_CREATE|os.O_RDWR, 0)
+		require.NoError(t, err)
+	}
+	exists := func(p string) bool {
+		_, err := s.Stat(p)
+		return err == nil
+	}
+
+	s.RenameAll("/a", "/c")
+	assert.False(t, exists("/a/.DS_Store"))
+	assert.True(t, exists("/c/.DS_Store"))
+	assert.True(t, exists("/c/b/._f"))
+	assert.True(t, exists("/ab/.DS_Store"))
+	assert.Equal(t, 4, s.recent.Len())
+
+	s.RemoveAll("/c")
+	assert.False(t, exists("/c/.DS_Store"))
+	assert.False(t, exists("/c/b/._f"))
+	assert.True(t, exists("/ab/.DS_Store"))
+	assert.True(t, exists("/._a"))
+	assert.Equal(t, 2, s.recent.Len())
+}
