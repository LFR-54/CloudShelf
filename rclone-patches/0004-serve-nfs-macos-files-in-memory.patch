diff --git a/cmd/serve/nfs/macmeta.go b/cmd/serve/nfs/macmeta.go
new file mode 100644
index 0000000..868d176
--- /dev/null
+++ b/cmd/serve/nfs/macmeta.go
@@ -0,0 +1,52 @@
+//go:build unix
+
+package nfs
+
+import (
+	"os"
+
+	billy "github.com/go-git/go-billy/v5"
+	"github.com/rclone/rclone/lib/macmeta"
+	"github.com/willscott/go-nfs/file"
+)
+
+// metaFile is an open macOS metadata file kept in memory.
+type metaFile struct {
+	*macmeta.Handle
+	name string
+}
+
+func (f metaFile) Name() string  { return f.name }
+func (f metaFile) Lock() error   { return nil }
+func (f metaFile) Unlock() error { return nil }
+
+var _ billy.File = metaFile{}
+
+// metaInfo describes a metadata file with the ownership and file id the NFS server reads from Sys.
+type metaInfo struct {
+	*macmeta.Info
+	sys *file.FileInfo
+}
+
+func (i metaInfo) Sys() any { return i.sys }
+
+// inMemory reports whether name is a macOS metadata file kept in memory instead of the VFS.
+func (f *FS) inMemory(name string) bool {
+	return f.meta != nil && macmeta.Match(name)
+}
+
+func (f *FS) openMeta(filename, name string, flag int, perm os.FileMode) (billy.File, error) {
+	h, err := f.meta.Open(filename, flag, perm)
+	if err != nil {
+		return nil, err
+	}
+	return metaFile{Handle: h, name: name}, nil
+}
+
+func (f *FS) statMeta(filename string) (os.FileInfo, error) {
+	info, err := f.meta.Stat(filename)
+	if err != nil {
+		return nil, err
+	}
+	return metaInfo{Info: info, sys: &file.FileInfo{Nlink: 1, UID: f.vfs.Opt.UID, GID: f.vfs.Opt.GID, Fileid: info.Inode()}}, nil
+}
diff --git a/cmd/serve/nfs/macmeta_test.go b/cmd/serve/nfs/macmeta_test.go
new file mode 100644
index 0000000..9617bf2
--- /dev/null
+++ b/cmd/serve/nfs/macmeta_test.go
@@ -0,0 +1,92 @@
+//go:build unix
+
+package nfs
+
+import (
+	"context"
+	"io"
+	"os"
+	"testing"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/macmeta"
+	"github.com/rclone/rclone/vfs"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/willscott/go-nfs/file"
+)
+
+func TestMetadataFilesInMemory(t *testing.T) {
+	ctx := context.Background()
+	remote, err := fs.NewFs(ctx, ":memory:nfs-macmeta-test")
+	require.NoError(t, err)
+	v := vfs.New(ctx, remote, nil)
+	f := &FS{vfs: v, meta: macmeta.New()}
+
+	w, err := f.Create("dir/._photo.jpg")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("attributes"))
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	fi, err := f.Stat("dir/._photo.jpg")
+	require.NoError(t, err)
+	assert.Equal(t, "._photo.jpg", fi.Name())
+	assert.Equal(t, int64(10), fi.Size())
+	sys, ok := fi.Sys().(*file.FileInfo)
+	require.True(t, ok)
+	assert.Equal(t, v.Opt.UID, sys.UID)
+	assert.GreaterOrEqual(t, sys.Fileid, uint64(1<<62))
+	_, err = v.Stat("dir/._photo.jpg")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+
+	_, err = f.OpenFile("dir/._photo.jpg", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o644)
+	assert.ErrorIs(t, err, os.ErrExist)
+
+	rw, err := f.OpenFile("dir/._photo.jpg", os.O_RDWR, 0)
+	require.NoError(t, err)
+	_, err = rw.Seek(4, io.SeekStart)
+	require.NoError(t, err)
+	_, err = rw.Write([]byte("IBUTES-X"))
+	require.NoError(t, err)
+	got := make([]byte, 32)
+	n, err := rw.ReadAt(got, 0)
+	assert.Equal(t, io.EOF, err)
+	assert.Equal(t, "attrIBUTES-X", string(got[:n]))
+	require.NoError(t, rw.Truncate(4))
+
+	require.NoError(t, f.Rename("dir/._photo.jpg", "dir/._image.jpg"))
+	_, err = f.Stat("dir/._photo.jpg")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	fi, err = f.Lstat("dir/._image.jpg")
+	require.NoError(t, err)
+	assert.Equal(t, int64(4), fi.Size())
+
+	assert.ErrorIs(t, f.Rename("dir/._image.jpg", "dir/image.jpg"), os.ErrPermission)
+	require.NoError(t, f.Chmod("dir/._image.jpg", 0o600))
+	require.NoError(t, f.Remove("dir/._image.jpg"))
+	_, err = f.Open("dir/._image.jpg")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	assert.ErrorIs(t, f.Remove("dir/._image.jpg"), os.ErrNotExist)
+
+	ds, err := f.Create(".DS_Store")
+	require.NoError(t, err)
+	_, err = ds.Write([]byte("Bud1"))
+	require.NoError(t, err)
+	fi, err = f.Stat(".DS_Store")
+	require.NoError(t, err)
+	assert.Equal(t, int64(4), fi.Size())
+	_, err = v.Stat(".DS_Store")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+
+	// Removing a directory removes the metadata files listings do not show.
+	require.NoError(t, f.MkdirAll("show", 0o755))
+	_, err = f.Create("show/.DS_Store")
+	require.NoError(t, err)
+	require.NoError(t, f.Rename("show", "series"))
+	_, err = f.Stat("series/.DS_Store")
+	require.NoError(t, err)
+	require.NoError(t, f.Remove("series"))
+	_, err = f.Stat("series/.DS_Store")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+}
diff --git a/lib/macmeta/macmeta.go b/lib/macmeta/macmeta.go
new file mode 100644
index 0000000..686a21e
--- /dev/null
+++ b/lib/macmeta/macmeta.go
@@ -0,0 +1,336 @@
+// Package macmeta keeps in memory the files macOS writes beside others to hold metadata: the ._ files that
+// carry extended attributes on a filesystem without them, and the .DS_Store files of the Finder.
+//
+// Filters hide such files from listings but do not apply to writes, so a mount would upload them, and
+// refusing them makes Finder copies fail. The remote could not keep them anyway: the files live until
+// removed, or until the least recently used are dropped.
+package macmeta
+
+import (
+	"container/list"
+	"io"
+	"os"
+	"path"
+	"strings"
+	"sync"
+	"time"
+)
+
+// MaxFiles bounds the memory used: a ._ file holding a few attributes is around 4 KiB, a .DS_Store up to
+// a few tens of KiB.
+const MaxFiles = 4096
+
+// firstInode is far above the VFS inode counter, so file ids never collide.
+const firstInode = 1 << 62
+
+// Match reports whether p names a macOS metadata file.
+func Match(p string) bool {
+	name := path.Base(p)
+	return strings.HasPrefix(name, "._") || name == ".DS_Store"
+}
+
+// Store holds metadata files by path.
+type Store struct {
+	mu     sync.Mutex
+	byPath map[string]*list.Element
+	recent *list.List // of *file, most recently used first
+	next   uint64
+}
+
+type file struct {
+	path  string
+	data  []byte
+	mode  os.FileMode
+	mtime time.Time
+	inode uint64
+}
+
+// New makes an empty Store.
+func New() *Store {
+	return &Store{byPath: map[string]*list.Element{}, recent: list.New(), next: firstInode}
+}
+
+// get returns the file at p, marking it as recently used. Called with the lock held.
+func (s *Store) get(p string) *file {
+	element, ok := s.byPath[p]
+	if !ok {
+		return nil
+	}
+	s.recent.MoveToFront(element)
+	return element.Value.(*file)
+}
+
+// add stores f at its path, dropping the least recently used past MaxFiles. Called with the lock held.
+func (s *Store) add(f *file) {
+	if old, ok := s.byPath[f.path]; ok {
+		s.recent.Remove(old)
+	}
+	s.byPath[f.path] = s.recent.PushFront(f)
+	for s.recent.Len() > MaxFiles {
+		oldest := s.recent.Back()
+		s.recent.Remove(oldest)
+		delete(s.byPath, oldest.Value.(*file).path)
+	}
+}
+
+// Open opens the file at p with os.OpenFile flags, creating it with perm when O_CREATE is set.
+//
+// It returns os.ErrNotExist or os.ErrExist as os.OpenFile does.
+func (s *Store) Open(p string, flag int, perm os.FileMode) (*Handle, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	f := s.get(p)
+	switch {
+	case f == nil && flag&os.O_CREATE == 0:
+		return nil, os.ErrNotExist
+	case f != nil && flag&os.O_CREATE != 0 && flag&os.O_EXCL != 0:
+		return nil, os.ErrExist
+	case f == nil:
+		s.next++
+		f = &file{path: p, mode: perm.Perm(), mtime: time.Now(), inode: s.next}
+		if f.mode == 0 {
+			f.mode = 0o644
+		}
+		s.add(f)
+	case flag&os.O_TRUNC != 0:
+		f.data = nil
+		f.mtime = time.Now()
+	}
+	h := &Handle{store: s, file: f}
+	if flag&os.O_APPEND != 0 {
+		h.offset = int64(len(f.data))
+	}
+	return h, nil
+}
+
+// Stat describes the file at p, or returns os.ErrNotExist.
+func (s *Store) Stat(p string) (*Info, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	f := s.get(p)
+	if f == nil {
+		return nil, os.ErrNotExist
+	}
+	return f.info(), nil
+}
+
+// Remove deletes the file at p, or returns os.ErrNotExist.
+func (s *Store) Remove(p string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	element, ok := s.byPath[p]
+	if !ok {
+		return os.ErrNotExist
+	}
+	s.recent.Remove(element)
+	delete(s.byPath, p)
+	return nil
+}
+
+// Rename moves the file at oldPath to newPath, replacing any file there, or returns os.ErrNotExist.
+func (s *Store) Rename(oldPath, newPath string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	f := s.get(oldPath)
+	if f == nil {
+		return os.ErrNotExist
+	}
+	s.recent.Remove(s.byPath[oldPath])
+	delete(s.byPath, oldPath)
+	f.path = newPath
+	s.add(f)
+	return nil
+}
+
+// RemoveAll deletes the files under dir, once dir has been removed. Listings do not show them, so they
+// would otherwise outlive the directory and be found again in a new one of the same name.
+func (s *Store) RemoveAll(dir string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.removeAll(dir)
+}
+
+// removeAll deletes the files under dir. Called with the lock held.
+func (s *Store) removeAll(dir string) {
+	prefix := strings.TrimSuffix(dir, "/") + "/"
+	for p, element := range s.byPath {
+		if strings.HasPrefix(p, prefix) {
+			s.recent.Remove(element)
+			delete(s.byPath, p)
+		}
+	}
+}
+
+// RenameAll moves the files under oldDir to newDir, once oldDir has been renamed, replacing those there.
+func (s *Store) RenameAll(oldDir, newDir string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	oldPrefix := strings.TrimSuffix(oldDir, "/") + "/"
+	var moved []*file
+	for p, element := range s.byPath {
+		if strings.HasPrefix(p, oldPrefix) {
+			moved = append(moved, element.Value.(*file))
+			s.recent.Remove(element)
+			delete(s.byPath, p)
+		}
+	}
+	s.removeAll(newDir)
+	newPrefix := strings.TrimSuffix(newDir, "/") + "/"
+	for _, f := range moved {
+		f.path = newPrefix + strings.TrimPrefix(f.path, oldPrefix)
+		s.add(f)
+	}
+}
+
+// Chmod sets the permissions of the file at p, or returns os.ErrNotExist.
+func (s *Store) Chmod(p string, mode os.FileMode) error {
+	return s.change(p, func(f *file) { f.mode = mode.Perm() })
+}
+
+// Chtimes sets the modification time of the file at p, or returns os.ErrNotExist.
+func (s *Store) Chtimes(p string, mtime time.Time) error {
+	return s.change(p, func(f *file) { f.mtime = mtime })
+}
+
+func (s *Store) change(p string, apply func(f *file)) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	f := s.get(p)
+	if f == nil {
+		return os.ErrNotExist
+	}
+	apply(f)
+	return nil
+}
+
+// info snapshots f. Called with the lock held.
+func (f *file) info() *Info {
+	return &Info{name: path.Base(f.path), size: int64(len(f.data)), mode: f.mode, mtime: f.mtime, inode: f.inode}
+}
+
+// Info describes a file. It implements os.FileInfo.
+type Info struct {
+	name  string
+	size  int64
+	mode  os.FileMode
+	mtime time.Time
+	inode uint64
+}
+
+// Name returns the base name of the file.
+func (i *Info) Name() string { return i.name }
+
+// Size returns the length of the file in bytes.
+func (i *Info) Size() int64 { return i.size }
+
+// Mode returns the permissions of the file.
+func (i *Info) Mode() os.FileMode { return i.mode }
+
+// ModTime returns the modification time of the file.
+func (i *Info) ModTime() time.Time { return i.mtime }
+
+// IsDir returns false: the store only holds files.
+func (i *Info) IsDir() bool { return false }
+
+// Sys returns nil.
+func (i *Info) Sys() any { return nil }
+
+// Inode returns the file id, unique within the store and above the ids of the VFS.
+func (i *Info) Inode() uint64 { return i.inode }
+
+// Handle is an open file. Read, Write and Seek share an offset; ReadAt and WriteAt ignore it.
+type Handle struct {
+	store  *Store
+	file   *file
+	offset int64
+}
+
+// Stat describes the file, even once it has been removed.
+func (h *Handle) Stat() *Info {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	return h.file.info()
+}
+
+// Read reads from the offset, returning io.EOF at the end of the file.
+func (h *Handle) Read(p []byte) (int, error) {
+	n, err := h.ReadAt(p, h.offset)
+	h.offset += int64(n)
+	return n, err
+}
+
+// ReadAt reads at off, returning io.EOF when it reaches the end of the file.
+func (h *Handle) ReadAt(p []byte, off int64) (int, error) {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	if off >= int64(len(h.file.data)) {
+		return 0, io.EOF
+	}
+	n := copy(p, h.file.data[off:])
+	if n < len(p) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// Write writes at the offset, growing the file as needed.
+func (h *Handle) Write(p []byte) (int, error) {
+	n, err := h.WriteAt(p, h.offset)
+	h.offset += int64(n)
+	return n, err
+}
+
+// WriteAt writes at off, growing the file as needed.
+func (h *Handle) WriteAt(p []byte, off int64) (int, error) {
+	if off < 0 {
+		return 0, os.ErrInvalid
+	}
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	end := off + int64(len(p))
+	if end > int64(len(h.file.data)) {
+		data := make([]byte, end)
+		copy(data, h.file.data)
+		h.file.data = data
+	}
+	copy(h.file.data[off:], p)
+	h.file.mtime = time.Now()
+	return len(p), nil
+}
+
+// Seek sets the offset used by Read and Write.
+func (h *Handle) Seek(offset int64, whence int) (int64, error) {
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += h.offset
+	case io.SeekEnd:
+		offset += int64(len(h.file.data))
+	default:
+		return h.offset, os.ErrInvalid
+	}
+	if offset < 0 {
+		return h.offset, os.ErrInvalid
+	}
+	h.offset = offset
+	return offset, nil
+}
+
+// Truncate sets the length of the file, padding it with zeros when it grows.
+func (h *Handle) Truncate(size int64) error {
+	if size < 0 {
+		return os.ErrInvalid
+	}
+	h.store.mu.Lock()
+	defer h.store.mu.Unlock()
+	data := make([]byte, size)
+	copy(data, h.file.data)
+	h.file.data = data
+	h.file.mtime = time.Now()
+	return nil
+}
+
+// Close does nothing: the file stays in the store until removed.
+func (h *Handle) Close() error { return nil }
