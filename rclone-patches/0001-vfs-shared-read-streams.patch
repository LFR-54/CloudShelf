diff --git a/fs/chunkedreader/budget.go b/fs/chunkedreader/budget.go
new file mode 100644
index 0000000..4f0f96e
--- /dev/null
+++ b/fs/chunkedreader/budget.go
@@ -0,0 +1,81 @@
+package chunkedreader
+
+import "sync"
+
+// initialStreams is how many streams a parallel reader starts with after
+// an open or a seek when the streams are shared, so the first bytes don't
+// compete with a long read ahead.
+const initialStreams = 4
+
+// streamBudget shares a number of simultaneous downloads between all the
+// parallel chunked readers of the process.
+//
+// Some providers refuse more simultaneous downloads per account than a
+// single reader with many streams would open, so the readers downloading
+// at the same time split the budget evenly.
+type streamBudget struct {
+	mu      sync.Mutex
+	total   int               // downloads allowed at once, 0 for no limit
+	active  int               // downloads in progress
+	readers map[*parallel]int // downloads in progress per reader
+}
+
+var budget = &streamBudget{readers: map[*parallel]int{}}
+
+// SetStreamsTotal limits the simultaneous downloads of all the parallel
+// chunked readers to n, or removes the limit if n <= 0.
+//
+// With a limit, each reader starts with up to 4 streams after an open or
+// a seek and doubles them while its reads wait on the network, up to its
+// streams setting and its share of n.
+func SetStreamsTotal(n int) {
+	budget.mu.Lock()
+	defer budget.mu.Unlock()
+	budget.total = max(0, n)
+}
+
+// shared reports whether the streams are shared between readers.
+func (b *streamBudget) shared() bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.total > 0
+}
+
+// acquire reports whether cr, which has queued streams already, may start
+// another download, and whether that download must be released.
+//
+// A reader with nothing queued always gets a stream so it can't starve.
+func (b *streamBudget) acquire(cr *parallel, queued int) (ok, counted bool) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.total <= 0 {
+		return true, false
+	}
+	if queued >= cr.want {
+		return false, false
+	}
+	mine := b.readers[cr]
+	downloading := len(b.readers)
+	if mine == 0 {
+		downloading++
+	}
+	share := max(1, b.total/downloading)
+	if queued > 0 && (mine >= share || b.active >= b.total) {
+		return false, false
+	}
+	b.active++
+	b.readers[cr] = mine + 1
+	return true, true
+}
+
+// release ends a download started with acquire.
+func (b *streamBudget) release(cr *parallel) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.active--
+	if n := b.readers[cr] - 1; n > 0 {
+		b.readers[cr] = n
+	} else {
+		delete(b.readers, cr)
+	}
+}
diff --git a/fs/chunkedreader/budget_test.go b/fs/chunkedreader/budget_test.go
new file mode 100644
index 0000000..b91d154
--- /dev/null
+++ b/fs/chunkedreader/budget_test.go
@@ -0,0 +1,96 @@
+package chunkedreader
+
+import (
+	"context"
+	"io"
+	"testing"
+
+	"github.com/rclone/rclone/fstest/mockobject"
+	"github.com/rclone/rclone/lib/multipart"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStreamBudgetShares(t *testing.T) {
+	b := &streamBudget{total: 4, readers: map[*parallel]int{}}
+	first, second := &parallel{want: 8}, &parallel{want: 8}
+
+	// Alone, a reader gets the whole budget but no more
+	for queued := range 4 {
+		ok, counted := b.acquire(first, queued)
+		require.True(t, ok)
+		require.True(t, counted)
+	}
+	ok, _ := b.acquire(first, 4)
+	assert.False(t, ok)
+
+	// A reader with nothing queued always gets a stream, but no second one over budget
+	ok, _ = b.acquire(second, 0)
+	assert.True(t, ok)
+	ok, _ = b.acquire(second, 1)
+	assert.False(t, ok)
+
+	// Once the first reader's downloads end, the second gets half the budget
+	b.release(first)
+	b.release(first)
+	b.release(first)
+	ok, _ = b.acquire(second, 1)
+	assert.True(t, ok)
+	ok, _ = b.acquire(second, 2)
+	assert.False(t, ok)
+
+	// The queue never goes past what the reader wants
+	ok, _ = b.acquire(first, 8)
+	assert.False(t, ok)
+
+	b.release(first)
+	b.release(second)
+	b.release(second)
+	assert.Equal(t, 0, b.active)
+	assert.Empty(t, b.readers)
+}
+
+func TestStreamBudgetUnlimited(t *testing.T) {
+	b := &streamBudget{readers: map[*parallel]int{}}
+	ok, counted := b.acquire(&parallel{want: 1}, 10)
+	assert.True(t, ok)
+	assert.False(t, counted)
+}
+
+func TestParallelSharedStreams(t *testing.T) {
+	SetStreamsTotal(3)
+	defer SetStreamsTotal(0)
+
+	content := makeContent(t, 1024)
+	for _, mode := range mockobject.SeekModes {
+		t.Run(mode.String(), testRead(content, mode, 8))
+	}
+
+	// Two readers reading at once return their content and give back every download
+	ctx := context.Background()
+	const size = 20*multipart.BufferSize + 255
+	content = makeContent(t, size)
+	readers := []ChunkedReader{}
+	for range 2 {
+		o := mockobject.New("test.bin").WithContent(content, mockobject.SeekModeNone)
+		readers = append(readers, New(ctx, o, multipart.BufferSize, 0, 8))
+	}
+	done := make(chan []byte, len(readers))
+	for _, cr := range readers {
+		go func() {
+			got, err := io.ReadAll(cr)
+			assert.NoError(t, err)
+			done <- got
+		}()
+	}
+	for range readers {
+		assert.Equal(t, content, <-done)
+	}
+	for _, cr := range readers {
+		require.NoError(t, cr.Close())
+	}
+	budget.mu.Lock()
+	defer budget.mu.Unlock()
+	assert.Equal(t, 0, budget.active)
+	assert.Empty(t, budget.readers)
+}
