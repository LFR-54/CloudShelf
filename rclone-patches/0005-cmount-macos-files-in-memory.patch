+// isMeta reports whether path is a macOS metadata file kept in memory.
+func (fsys *FS) isMeta(path string) bool {
+	return fsys.meta != nil && macmeta.Match(path)
+}
+
+// openMeta opens the metadata file at path, returning its file handle.
+func (fsys *FS) openMeta(path string, flags int, mode uint32) (errc int, fh uint64) {
+	handle, err := fsys.meta.Open(path, flags, os.FileMode(mode))
+	if err != nil {
+		return translateError(err), fhUnset
+	}
+	fsys.mu.Lock()
+	defer fsys.mu.Unlock()
+	fsys.metaNext++
+	fh = metaHandle | fsys.metaNext
+	fsys.metaFiles[fh] = handle
+	return 0, fh
+}
+
+// getMeta returns the metadata file open as fh.
+func (fsys *FS) getMeta(fh uint64) (handle *macmeta.Handle, errc int) {
+	fsys.mu.Lock()
+	defer fsys.mu.Unlock()
+	handle, ok := fsys.metaFiles[fh]
+	if !ok {
+		return nil, -fuse.EBADF
+	}
+	return handle, 0
+}
+
+// releaseMeta closes the metadata file open as fh.
+func (fsys *FS) releaseMeta(fh uint64) (errc int) {
+	fsys.mu.Lock()
+	defer fsys.mu.Unlock()
+	if _, ok := fsys.metaFiles[fh]; !ok {
+		return -fuse.EBADF
+	}
+	delete(fsys.metaFiles, fh)
+	return 0
+}
