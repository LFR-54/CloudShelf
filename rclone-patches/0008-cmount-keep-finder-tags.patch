diff --git a/lib/macmeta/attrs.go b/lib/macmeta/attrs.go
new file mode 100644
index 0000000..5a19cbc
--- /dev/null
+++ b/lib/macmeta/attrs.go
@@ -0,0 +1,188 @@
+package macmeta
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+// kept lists the extended attributes Attrs keeps: the Finder's tags, colour label and comment.
+var kept = map[string]bool{
+	"com.apple.metadata:_kMDItemUserTags":     true,
+	"com.apple.FinderInfo":                    true,
+	"com.apple.metadata:kMDItemFinderComment": true,
+}
+
+// finderInfo is the attribute holding the colour label, among flags; all zeros means none.
+const finderInfo = "com.apple.FinderInfo"
+
+// MaxAttrSize bounds a kept value: a list of tags or a comment takes a few hundred bytes.
+const MaxAttrSize = 64 * 1024
+
+// Keeps reports whether Attrs keeps the attribute name.
+func Keeps(name string) bool {
+	return kept[name]
+}
+
+// key is the form of a path in Attrs. The Finder passes paths with decomposed accents and the shell with
+// precomposed ones, both naming the same file.
+func key(p string) string {
+	return norm.NFC.String(p)
+}
+
+// Attrs keeps the Finder's own extended attributes by path, in a file on this computer.
+//
+// A remote has nowhere to keep extended attributes, so a mount drops them, and the Finder then shows no
+// tag on its files. These few are kept instead, and follow their files as they are renamed or removed
+// through the mount. Changes made to the remote from elsewhere are not seen.
+type Attrs struct {
+	mu     sync.Mutex
+	file   string
+	byPath map[string]map[string][]byte
+}
+
+// OpenAttrs loads the attributes saved in file, which need not exist yet.
+func OpenAttrs(file string) (*Attrs, error) {
+	a := &Attrs{file: file, byPath: map[string]map[string][]byte{}}
+	data, err := os.ReadFile(file)
+	if errors.Is(err, os.ErrNotExist) {
+		return a, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(data, &a.byPath); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+// Get returns the attribute name of p.
+func (a *Attrs) Get(p, name string) (value []byte, ok bool) {
+	p = key(p)
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	value, ok = a.byPath[p][name]
+	return value, ok
+}
+
+// List returns the names of the attributes of p, sorted.
+func (a *Attrs) List(p string) (names []string) {
+	p = key(p)
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	for name := range a.byPath[p] {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// Set sets the attribute name of p and saves. A FinderInfo of zeros, which the Finder writes to clear a
+// colour label, removes it.
+func (a *Attrs) Set(p, name string, value []byte) error {
+	if name == finderInfo && len(bytes.Trim(value, "\x00")) == 0 {
+		_, err := a.Remove(p, name)
+		return err
+	}
+	p = key(p)
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.byPath[p] == nil {
+		a.byPath[p] = map[string][]byte{}
+	}
+	a.byPath[p][name] = bytes.Clone(value)
+	return a.save()
+}
+
+// Remove removes the attribute name of p, reporting whether it was set.
+func (a *Attrs) Remove(p, name string) (removed bool, err error) {
+	p = key(p)
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if _, ok := a.byPath[p][name]; !ok {
+		return false, nil
+	}
+	delete(a.byPath[p], name)
+	if len(a.byPath[p]) == 0 {
+		delete(a.byPath, p)
+	}
+	return true, a.save()
+}
+
+// RemoveAll removes the attributes of p and of everything under it, once p has been removed.
+func (a *Attrs) RemoveAll(p string) error {
+	p = key(p)
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if !a.removeAll(p) {
+		return nil
+	}
+	return a.save()
+}
+
+// removeAll removes the attributes of p and of everything under it, reporting whether there were any.
+// Called with the lock held.
+func (a *Attrs) removeAll(p string) (changed bool) {
+	prefix := strings.TrimSuffix(p, "/") + "/"
+	for q := range a.byPath {
+		if q == p || strings.HasPrefix(q, prefix) {
+			delete(a.byPath, q)
+			changed = true
+		}
+	}
+	return changed
+}
+
+// RenameAll moves the attributes of oldPath and of everything under it to newPath, once renamed,
+// replacing those there.
+func (a *Attrs) RenameAll(oldPath, newPath string) error {
+	oldPath, newPath = key(oldPath), key(newPath)
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	oldPrefix := strings.TrimSuffix(oldPath, "/") + "/"
+	moved := map[string]map[string][]byte{}
+	for q, attrs := range a.byPath {
+		switch {
+		case q == oldPath:
+			moved[newPath] = attrs
+		case strings.HasPrefix(q, oldPrefix):
+			moved[strings.TrimSuffix(newPath, "/")+"/"+strings.TrimPrefix(q, oldPrefix)] = attrs
+		default:
+			continue
+		}
+		delete(a.byPath, q)
+	}
+	changed := a.removeAll(newPath)
+	if len(moved) == 0 && !changed {
+		return nil
+	}
+	for q, attrs := range moved {
+		a.byPath[q] = attrs
+	}
+	return a.save()
+}
+
+// save writes the attributes to their file through a temporary one, so a crash leaves the old or the new.
+// Called with the lock held.
+func (a *Attrs) save() error {
+	data, err := json.Marshal(a.byPath)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(a.file), 0o700); err != nil {
+		return err
+	}
+	tmp := a.file + ".tmp"
+	if err := os.WriteFile(tmp, data, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, a.file)
+}
diff --git a/lib/macmeta/attrs_test.go b/lib/macmeta/attrs_test.go
new file mode 100644
index 0000000..c4c4007
--- /dev/null
+++ b/lib/macmeta/attrs_test.go
@@ -0,0 +1,96 @@
+package macmeta
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const tags = "com.apple.metadata:_kMDItemUserTags"
+
+func TestKeeps(t *testing.T) {
+	assert.True(t, Keeps(tags))
+	assert.True(t, Keeps("com.apple.FinderInfo"))
+	assert.False(t, Keeps("com.apple.quarantine"))
+	assert.False(t, Keeps("com.apple.ResourceFork"))
+}
+
+func TestAttrsPersist(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "sub", "attrs.json")
+	a, err := OpenAttrs(file)
+	require.NoError(t, err)
+	_, ok := a.Get("/dir", tags)
+	assert.False(t, ok)
+
+	require.NoError(t, a.Set("/dir", tags, []byte("red")))
+	require.NoError(t, a.Set("/dir", "com.apple.metadata:kMDItemFinderComment", []byte("note")))
+	assert.Equal(t, []string{tags, "com.apple.metadata:kMDItemFinderComment"}, a.List("/dir"))
+
+	b, err := OpenAttrs(file)
+	require.NoError(t, err)
+	value, ok := b.Get("/dir", tags)
+	assert.True(t, ok)
+	assert.Equal(t, []byte("red"), value)
+
+	removed, err := b.Remove("/dir", tags)
+	require.NoError(t, err)
+	assert.True(t, removed)
+	removed, err = b.Remove("/dir", tags)
+	require.NoError(t, err)
+	assert.False(t, removed)
+	assert.Equal(t, []string{"com.apple.metadata:kMDItemFinderComment"}, b.List("/dir"))
+}
+
+func TestAttrsClearedFinderInfo(t *testing.T) {
+	a, err := OpenAttrs(filepath.Join(t.TempDir(), "attrs.json"))
+	require.NoError(t, err)
+	label := make([]byte, 32)
+	label[9] = 0x0c
+	require.NoError(t, a.Set("/file", "com.apple.FinderInfo", label))
+	assert.Equal(t, []string{"com.apple.FinderInfo"}, a.List("/file"))
+	require.NoError(t, a.Set("/file", "com.apple.FinderInfo", make([]byte, 32)))
+	assert.Empty(t, a.List("/file"))
+}
+
+func TestAttrsFollowFiles(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "attrs.json")
+	a, err := OpenAttrs(file)
+	require.NoError(t, err)
+	for _, p := range []string{"/dir", "/dir/file", "/dir/sub/file", "/dirx", "/other"} {
+		require.NoError(t, a.Set(p, tags, []byte(p)))
+	}
+
+	require.NoError(t, a.RenameAll("/dir", "/other"))
+	for _, p := range []string{"/dir", "/dir/file", "/dir/sub/file"} {
+		assert.Empty(t, a.List(p), p)
+	}
+	for p, from := range map[string]string{"/other": "/dir", "/other/file": "/dir/file", "/other/sub/file": "/dir/sub/file", "/dirx": "/dirx"} {
+		value, ok := a.Get(p, tags)
+		assert.True(t, ok, p)
+		assert.Equal(t, []byte(from), value, p)
+	}
+
+	require.NoError(t, a.RemoveAll("/other"))
+	assert.Empty(t, a.List("/other"))
+	assert.Empty(t, a.List("/other/sub/file"))
+	assert.Equal(t, []string{tags}, a.List("/dirx"))
+
+	b, err := OpenAttrs(file)
+	require.NoError(t, err)
+	assert.Empty(t, b.List("/other/file"))
+	assert.Equal(t, []string{tags}, b.List("/dirx"))
+}
+
+func TestAttrsAccents(t *testing.T) {
+	a, err := OpenAttrs(filepath.Join(t.TempDir(), "attrs.json"))
+	require.NoError(t, err)
+	decomposed, precomposed := "/Re\u0301sume\u0301", "/R\u00e9sum\u00e9"
+	require.NoError(t, a.Set(decomposed, tags, []byte("red")))
+	value, ok := a.Get(precomposed, tags)
+	assert.True(t, ok)
+	assert.Equal(t, []byte("red"), value)
+	require.NoError(t, a.RenameAll(precomposed, decomposed+"2"))
+	assert.Equal(t, []string{tags}, a.List(precomposed+"2"))
+}
